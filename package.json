{
  "name": "campus-compute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "server": "node --import tsx src/server/main.ts",
    "worker": "node --import tsx src/worker/main.ts",
    "probe": "node --import tsx scripts/probe.ts",
    "prepare:arc": "node --import tsx scripts/prepare-arc.ts",
    "prepare:data:test": "node --import tsx scripts/prepare-arc-test.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "node --import tsx scripts/build-web.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:showcase": "node --import tsx scripts/build-showcase.ts"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
    "fastify": "5.12.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "node": "24.21.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
